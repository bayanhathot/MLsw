# Editors and operating-system files (kept locally, never removed by this rule).
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets. Keep documented examples in Git.
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example

# Python environments, caches, coverage, and build products.
**/.venv/
**/.ml-venv/
**/venv/
**/.venv.zip
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]
backend/app/uploads/*
!backend/app/uploads/.gitkeep
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# JavaScript dependencies and Svelte/Vite output.
**/node_modules/
**/.svelte-kit/
frontend/build/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

backend/app/static/audio/demo.mp3

# Runtime logs and scratch files.
*.log
*.tmp
*.bak
