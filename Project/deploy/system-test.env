# Disposable CI/local values for docker-compose.prod.yml. This file contains
# no production secret and must only be used with an isolated stack that is
# removed with `docker compose down --volumes` after the test.
BACKEND_IMAGE=cuemix-backend:system-test
FRONTEND_IMAGE=cuemix-frontend:system-test
STUDIO_AI_IMAGE=cuemix-studio-ai:system-test

# Caddy gives localhost a local HTTPS certificate. Browser/curl tests opt in
# to trusting that disposable certificate while still exercising secure
# cookies, HTTPS redirects, and the real production reverse-proxy routes.
DOMAIN=localhost
CORS_ORIGINS=https://localhost

POSTGRES_DB=cuemix_system_test
POSTGRES_USER=cuemix_system_test
POSTGRES_PASSWORD=ci-only-system-test-password
DATABASE_URL=postgresql+psycopg2://cuemix_system_test:ci-only-system-test-password@postgres:5432/cuemix_system_test

SECRET_KEY=ci-only-system-test-secret-with-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SAMESITE=lax

BACKEND_WORKERS=1
UPLOAD_WORKERS=4
UPLOAD_QUEUE_CAPACITY=32
UPLOAD_JOB_TTL_SECONDS=600
CATALOG_AUDIO_MAX_MB_COMPRESSED=30
CATALOG_AUDIO_MAX_MB_LOSSLESS=100
CATALOG_BATCH_PRIORITY_DECAY_EVERY=3
ARTIST_MATCH_THRESHOLD=0.3

# Keep the system test deterministic and self-contained. Ollama remains an
# optional production refinement; the separate Studio AI container is still
# started and health-checked, but no model download is needed in CI.
VIBE_LLM_PROVIDER=none
ENABLE_COLD_SEED=false
ENABLE_PIPELINE_DEBUG=false
DEBUG_DASHBOARD_ENABLED=true
AUDIUS_ANALYSIS_CACHE_ENABLED=false
REDIS_URL=redis://redis:6379/0

STUDIO_ENABLED=true
STUDIO_AI_URL=http://studio-ai-service:8001
STUDIO_AI_INTERNAL_TOKEN=ci-only-studio-ai-token
STUDIO_AI_TIMEOUT_SECONDS=15
STUDIO_AI_MODEL_TIMEOUT_SECONDS=15
STUDIO_AI_MAX_CONTEXT_ITEMS=30
STUDIO_AI_MAX_OUTPUT_TOKENS=700
STUDIO_AI_TEMPERATURE=0.15
STUDIO_MIN_SEGMENT_MS=1000
STUDIO_MAX_SEGMENT_MS=300000
