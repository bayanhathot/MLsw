# BACKEND_IMAGE and FRONTEND_IMAGE are intentionally not set here: the
# deploy workflow (.github/workflows/cuemix-ci-cd.yml) and remote-deploy.sh
# inject them as commit-tagged GHCR image references at deploy time, not
# via this file. docker-compose.prod.yml requires both to be set somehow.

DOMAIN=sweng-group-18.eastus.cloudapp.azure.com
CORS_ORIGINS=https://sweng-group-18.eastus.cloudapp.azure.com

POSTGRES_DB=cuemix_db
POSTGRES_USER=cuemix_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://cuemix_user:replace-with-a-long-random-password@postgres:5432/cuemix_db

SECRET_KEY=replace-with-at-least-32-random-bytes
ALGORITHM=HS256
# Shorter than the 180-minute local-dev default (.env.example) -- a
# deliberate production hardening choice, not a drift/typo.
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SAMESITE=lax
# Keep one process while WebSocket fanout and upload jobs are in-memory.
BACKEND_WORKERS=1
UPLOAD_WORKERS=4
UPLOAD_QUEUE_CAPACITY=32
UPLOAD_JOB_TTL_SECONDS=3600
CATALOG_AUDIO_MAX_MB_COMPRESSED=30
CATALOG_AUDIO_MAX_MB_LOSSLESS=100
CATALOG_BATCH_PRIORITY_DECAY_EVERY=3
ARTIST_MATCH_THRESHOLD=0.3
# Internal AI-DJ pipeline / Ollama debug panel. Keep off in production.
ENABLE_PIPELINE_DEBUG=false
# Cold-seeds a realistic ~50-user dataset (accounts, profiles, social graph,
# forum activity, DMs, mixes, DJ sessions, listening history -- see
# app/coldseed/build.py) as part of every deploy's one-shot migrate service.
# On by default so the app always launches pre-seeded; idempotent
# (ColdSeedRun version marker), so re-running it on every redeploy never
# creates duplicates. Set to false to opt out.
ENABLE_COLD_SEED=true
# Bump this to regenerate a materially different dataset on the next deploy;
# leave it alone to keep re-running as a no-op against the existing data.
COLD_SEED_VERSION=v1
# Fixes the RNG driving every generated name/post/timestamp/relationship, so
# the same version always reproduces the exact same dataset.
COLD_SEED_RANDOM_SEED=2026

# Which LLM (if any) refines the deterministic prompt parse: ollama | none.
# docker-compose.prod.yml defaults this to "ollama", the sole LLM option, if
# unset here; a missing/incomplete OLLAMA_BASE_URL/OLLAMA_MODEL degrades to
# the deterministic parse rather than failing to boot (see
# pipeline/dependencies.py).
VIBE_LLM_PROVIDER=ollama

# The "ollama" service in docker-compose.prod.yml always runs (same as
# postgres) but is never a hard dependency for backend startup.
# deploy/remote-deploy.sh pulls OLLAMA_MODEL automatically after every
# deploy (idempotent -- a no-op once it's already present), so no manual
# step is needed here.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=15
OLLAMA_MAX_CONCURRENCY=4
# Qwen3's "thinking mode" adds real latency to the classification call and is
# the likely cause of Ollama call timeouts on unconfirmed GPUs -- off by
# default to reduce timeout risk; set to true once this deployment's GPU is
# confirmed to handle it within OLLAMA_TIMEOUT_SECONDS.
OLLAMA_THINK_ENABLED=false
# How long Ollama keeps the model resident in memory after a request before
# unloading it (Ollama's own default is 5 minutes). "-1" means never unload --
# avoids the cold-reload-from-disk latency a request pays after any gap in
# traffic. Accepts Ollama's own duration syntax directly (e.g. "30m", "1h").
OLLAMA_KEEP_ALIVE=-1

# Not yet used by any app code -- purely additive infrastructure (see
# app/core/redis_client.py). docker-compose.prod.yml defaults this to the
# "redis" service below if unset here.
REDIS_URL=redis://redis:6379/0

# Gates live Audius audio fetch for the persistent analysis cache. See
# Project/SECURITY.md's "Third-party compliance gates" section: risk
# accepted 2026-08-20 by the project owner (not written approval from
# Audius). When true, a temporary full-audio fetch runs per new/stale
# Audius candidate (deleted immediately after analysis succeeds or fails;
# only derived metadata is persisted). Enabled for the current course test
# deployment after the recorded risk acceptance. Automated deploys also
# synchronize this value into the VM's persistent .env.
AUDIUS_ANALYSIS_CACHE_ENABLED=true
# Cap on re-dispatch attempts for a new/stale/failed external-track
# analysis row before it's left alone (see external_track_cache.py).
EXTERNAL_ANALYSIS_MAX_ATTEMPTS=3

# Gates the admin debug dashboard (/admin/debug, routers/admin_debug.py) --
# session-loop trace visibility, the Audius analysis cache table, and a
# recent-activity/failure feed. Reachable by any logged-in account once
# true (see routers/admin_debug.py's own docstring for why "any account"
# rather than one specific owner), killable instantly by flipping this
# back to false without a redeploy. Both this file AND the VM's persisted
# .env must be updated for it to take effect, same caveat as
# AUDIUS_ANALYSIS_CACHE_ENABLED above.
DEBUG_DASHBOARD_ENABLED=true
