DOMAIN=group-name.region.cloudapp.azure.com
CORS_ORIGINS=https://group-name.region.cloudapp.azure.com

POSTGRES_DB=zonix_db
POSTGRES_USER=zonix_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://zonix_user:replace-with-a-long-random-password@postgres:5432/zonix_db

SECRET_KEY=replace-with-at-least-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SAMESITE=lax
# Keep one process while WebSocket fanout and upload jobs are in-memory.
BACKEND_WORKERS=1
UPLOAD_WORKERS=4
UPLOAD_QUEUE_CAPACITY=32
UPLOAD_JOB_TTL_SECONDS=3600
