# Must be the Azure-provided FQDN for your VM, e.g.
# course-group-07.eastus.cloudapp.azure.com - Let's Encrypt cannot issue a
# certificate for a bare IP address.
DOMAIN=course-groupNN.region.cloudapp.azure.com

POSTGRES_DB=zonix_db
POSTGRES_USER=zonix_user
POSTGRES_PASSWORD=replace_with_a_long_random_password

DATABASE_URL=postgresql+psycopg2://zonix_user:replace_with_a_long_random_password@postgres:5432/zonix_db

SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

BACKEND_WORKERS=2
