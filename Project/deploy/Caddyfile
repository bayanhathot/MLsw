{$DOMAIN} {
	encode zstd gzip

	redir /api /api/ 308

	# Preserve /api because FastAPI is configured with ROOT_PATH=/api. Caddy
	# manages WebSocket upgrades and replaces spoofable forwarding headers.
	handle /api/* {
		request_body {
			max_size 10485760
		}
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
