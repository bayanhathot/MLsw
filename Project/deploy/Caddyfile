{$DOMAIN} {
	encode zstd gzip

	redir /api /api/ 308

	# handle_path strips /api before forwarding. Caddy manages WebSocket
	# upgrades and replaces spoofable client-forwarding headers by default.
	handle_path /api/* {
		request_body {
			max_size 10485760
		}
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
