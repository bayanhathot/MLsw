{$DOMAIN} {
	encode zstd gzip

	redir /api /api/ 308

	# handle_path strips /api before forwarding. Caddy manages WebSocket
	# upgrades and replaces spoofable client-forwarding headers by default.
	handle_path /api/* {
		# 125829120 = 120 MiB: comfortably above the largest single-file
		# catalog-audio cap (CATALOG_AUDIO_MAX_MB_LOSSLESS, 100 MiB default)
		# plus multipart overhead. Bulk uploads send one file per request
		# (see routers/catalog.py's /catalog/tracks/batch-jobs), so a single
		# request never needs to hold more than one file's worth of body.
		request_body {
			max_size 125829120
		}
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
