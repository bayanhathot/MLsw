# .env.example
#
# This file is safe to commit to GitHub.
# It documents which environment variables the project needs.
# Each teammate copies this file to .env and fills real values.

POSTGRES_DB=zonix_db
POSTGRES_USER=zonix_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://zonix_user:change_me@postgres:5432/zonix_db

# Secret key used to sign JWT tokens.
# In real production, this should be long, random, and private.
SECRET_KEY=change_this_to_a_long_random_secret

# Algorithm used for signing JWT tokens.
ALGORITHM=HS256

# Token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Public website domain used by the production reverse proxy.
DOMAIN=zonix.example.com

# Number of Uvicorn worker processes used on the production server.
BACKEND_WORKERS=2

# The local backend address returned for demo audio links.
# Production overrides this with /api in docker-compose.prod.yml.
BACKEND_PUBLIC_URL=http://localhost:5000

# Production HTTPS deployments set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
