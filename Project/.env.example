# Copy to .env for local Docker Compose. Never commit the resulting .env file.
APP_ENV=development

POSTGRES_DB=cuemix_db
POSTGRES_USER=cuemix_user
POSTGRES_PASSWORD=cuemix_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://cuemix_user:cuemix_dev_password@postgres:5432/cuemix_db
# Use this URL only when running Alembic directly from the host.
DATABASE_URL_LOCAL=postgresql+psycopg2://cuemix_user:cuemix_dev_password@localhost:5432/cuemix_db

# Replace this in every shared or deployed environment (`openssl rand -hex 32`).
SECRET_KEY=local-development-secret-replace-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser-facing URLs are relative so the Nginx /api proxy works on any host.
BACKEND_PUBLIC_URL=/api
ROOT_PATH=/api
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Keep false whenever the backend host port can be reached directly.
TRUST_PROXY_HEADERS=false

FRONTEND_PORT=8080
BACKEND_PORT=5000
ADMINER_PORT=8081
REDIS_PORT=6379

# Not yet used by any app code -- purely additive infrastructure (see
# app/core/redis_client.py). Leave blank to use docker-compose.yml's default
# (redis://redis:6379/0), which matches the "redis" service below.
REDIS_URL=

# Which LLM (if any) refines the deterministic prompt parse: ollama | none.
# Defaults to "ollama" in the app itself if this is unset entirely; set to
# "none" here for zero-friction local dev with no LLM call, or "ollama" to
# use the ollama container below (already running by default -- just pull a
# model and set this).
VIBE_LLM_PROVIDER=none

# Ollama (fully local, the sole LLM option). Leave blank to use
# docker-compose.yml's defaults (http://ollama:11434, qwen3:8b), which match
# the "ollama" service -- pull the model once before switching:
# `docker compose exec ollama ollama pull qwen3:8b`. See BACKEND_README.md /
# CUEMIX_PROJECT_README.md for the full walkthrough.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=15
OLLAMA_MAX_CONCURRENCY=4
# Qwen3's "thinking mode" adds real latency to the classification call and is
# the likely cause of Ollama call timeouts on unconfirmed GPUs -- off by
# default to reduce timeout risk; set to true once a deployment's GPU is
# confirmed to handle it within OLLAMA_TIMEOUT_SECONDS.
OLLAMA_THINK_ENABLED=false
# How long Ollama keeps the model resident in memory after a request before
# unloading it (Ollama's own default is 5 minutes). "-1" means never unload --
# avoids the cold-reload-from-disk latency a request pays after any gap in
# traffic. Accepts Ollama's own duration syntax directly (e.g. "30m", "1h").
OLLAMA_KEEP_ALIVE=-1

# In-container upload queue. Compose persists this directory in a named volume.
# Catalog track audio and AudioRenderer's rendered mixes live under
# UPLOAD_DIR/catalog and UPLOAD_DIR/renders respectively.
UPLOAD_DIR=/data/uploads
UPLOAD_WORKERS=4
UPLOAD_QUEUE_CAPACITY=32
UPLOAD_JOB_TTL_SECONDS=3600

# Minimum pg_trgm (or pure-Python fallback) similarity for a named artist to
# resolve against the real catalog; below this, CandidateRetriever reports no
# match rather than guessing.
ARTIST_MATCH_THRESHOLD=0.3

# Internal AI-DJ pipeline / Ollama debug panel (frontend, main screen).
# Off by default -- never enable this on a shared/public deployment. Requires
# a logged-in user even when true.
ENABLE_PIPELINE_DEBUG=false

# Cold-seeds a realistic ~50-user dataset (accounts, profiles, social graph,
# forum activity, DMs, mixes, DJ sessions, listening history -- see
# app/coldseed/build.py) as part of every `docker compose up` via the
# one-shot migrate service. On by default so the app always launches
# pre-seeded; idempotent (ColdSeedRun version marker), so re-running it on
# every redeploy never creates duplicates. Set to false to opt out.
ENABLE_COLD_SEED=true
# Bump this to regenerate a materially different dataset on the next deploy
# (a new version is treated as never-seeded); leave it alone to keep
# re-running as a no-op against the existing seeded data.
COLD_SEED_VERSION=v1
# Fixes the RNG driving every generated name/post/timestamp/relationship, so
# the same version always reproduces the exact same dataset.
COLD_SEED_RANDOM_SEED=2026
